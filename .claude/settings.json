{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Glob",
      "Grep",
      "Write(slop/**/*)",
      "Edit(slop/**/*)",
      "WebFetch",
      "WebSearch",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskStop",
      "TaskOutput",
      "TaskUpdate"
    ],
    "defaultMode": "dontAsk",
    "deny": [
      "Agent",
      "Write(.claude/**/*)",
      "Edit(.claude/**/*)"
    ]
  },
  "skills": [
    {
      "name": "factorio-research",
      "path": ".claude/skills/factorio-research.md"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"$CLAUDE_PROJECT_DIR/.claude/log\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hook-restrict-read-grep-glob-paths.py\" \"$CLAUDE_PROJECT_DIR/.claude/log\""
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hook-forbid-reads-by-glob.py\" \"$CLAUDE_PROJECT_DIR/.claude/log\""
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hook-restrict-webfetch-urls.py\" \"$CLAUDE_PROJECT_DIR/.claude/log\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hook-restrict-bash.py\" \"$CLAUDE_PROJECT_DIR/.claude/log\""
          }
        ]
      }
    ]
  }
}