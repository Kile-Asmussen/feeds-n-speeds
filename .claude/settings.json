{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(slop/**/*)",
      "Write(slop/**/*)",
      "WebFetch(domain:lua-api.factorio.com)",
      "WebSearch"
    ],
    "defaultMode": "dontAsk",
    "deny": [
      "Bash",
      "Agent",
      "NotebookEdit",
      "TodoWrite",
      "CronCreate",
      "CronDelete"
    ]
  }
}
